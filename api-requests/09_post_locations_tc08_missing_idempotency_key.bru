meta {
  name: Reject registration without an idempotency key
  type: http
  seq: 9
}

post {
  url: {{base_url}}/api/locations
  body: json
}

headers {
  Content-Type: application/json
  X-Flight-Monitor: 1
}

body:json {
  {
    "latitude": 0,
    "longitude": 0
  }
}

tests {
  test("requires an idempotency key", function() {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}
